{
  "name": "moye-markdown",
  "version": "1.1.0",
  "private": true,
  "description": "A lightweight, offline Windows Markdown editor for local files.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/render.test.mjs tests/paste.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "media:capture": "node scripts/media/capture.mjs",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "dompurify": "^3.2.6",
    "lucide": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5"
  }
}
